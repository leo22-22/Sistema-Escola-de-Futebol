# Trechos do .env para produção (Hostinger VPS). O resto vem do .env padrão do Laravel.
APP_NAME="Caio Pina"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.caiopina.com.br
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caiopina
DB_USERNAME=caiopina
DB_PASSWORD=troque-esta-senha

QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

ESCOLINHA_NOME="Clínica de Futebol Caio Pina"
ESCOLINHA_NOME_CURTO="Caio Pina"
ESCOLINHA_TERMO_VERSAO=2026-1
DONO_NOME="Nome do dono"
DONO_EMAIL=
DONO_SENHA_INICIAL=troque-no-primeiro-acesso

# Push no celular (opcional): composer require laravel-notification-channels/webpush
# php artisan webpush:vapid  -> gera VAPID_PUBLIC_KEY e VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
